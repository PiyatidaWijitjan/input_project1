<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivMenuIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:tint="@color/shopee_orange"
        tools:src="@android:drawable/ic_menu_myplaces"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvMenuTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:text="ที่อยู่จัดส่งของฉัน" />

    <TextView
        android:id="@+id/tvMenuSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="1,250 เหรียญ"
        tools:visibility="visible" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/gray_text"
        tools:ignore="ContentDescription" />

</LinearLayout>