<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#212121</color>
    <color name="gray_bg">#F5F5F5</color>
    <color name="gray_text">#757575</color>
    <color name="price_red">#EE4D2D</color>
    <color name="shopee_orange">#EE4D2D</color>
    <color name="shopee_orange_dark">#D23F1D</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Shopee Clone</string>
    <string name="buy_now">ซื้อสินค้า</string>
    <string name="nav_home">หน้าหลัก</string>
    <string name="nav_profile">โปรไฟล์</string>
    <string name="nav_settings">ตั้งค่า</string>
    <string name="place_order">สั่งซื้อสินค้า</string>
    <string name="select_district">อำเภอ / เขต</string>
    <string name="select_province">จังหวัด</string>
    <string name="select_subdistrict">ตำบล / แขวง</string>
    <string name="shipping_address">ที่อยู่จัดส่ง</string>
    <string name="zipcode">รหัสไปรษณีย์</string>
    <style name="AppInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="AppInputDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="DividerThin">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/gray_bg</item>
        <item name="android:layout_marginStart">52dp</item>
    </style>
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/gray_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.ShopeeClone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shopee_orange</item>
        <item name="colorPrimaryDark">@color/shopee_orange_dark</item>
        <item name="colorAccent">@color/shopee_orange</item>
        <item name="android:windowBackground">@color/gray_bg</item>
        <item name="android:statusBarColor">@color/shopee_orange</item>
    </style>
</resources>